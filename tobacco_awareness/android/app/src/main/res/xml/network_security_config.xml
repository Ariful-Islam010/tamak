<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config
    Backend is HTTPS (https://tamak.jantrasoft.online) — no cleartext needed.
    Only system trusted CAs are allowed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
