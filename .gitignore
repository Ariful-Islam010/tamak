# ============================================================
# Tobacco_Awareness Monorepo — .gitignore
# ============================================================

# --- Secrets & Environment ---
.env
**/.env
.env.*
!.env.example
!**/.env.example

# --- Android Signing Keys (NEVER commit) ---
*.jks
*.keystore
tobacco_awareness/android/key.properties

# --- Flutter & Dart ---
tobacco_awareness/.dart_tool/
tobacco_awareness/.flutter-plugins-dependencies
tobacco_awareness/.pub-cache/
tobacco_awareness/.pub/
tobacco_awareness/build/
tobacco_awareness/pubspec.lock

# --- Node.js (should not be in Flutter project) ---
node_modules/
**/node_modules/
package-lock.json

# --- Python Backend ---
tobacco_awareness_backend/venv/
tobacco_awareness_backend/.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# --- IDE & Editor ---
.idea/
.vscode/
*.iml
*.ipr
*.iws

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Build / Release ---
*.zip
*.rar
*.apk
*.aab
*.ipa

# --- Supabase CLI cache ---
tobacco_awareness/supabase/.temp/
